# ==============================================================================
# SHRI RADHE RADHE RESTAURANT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# COPY THIS FILE TO .env AND POPULATE WITH REAL CREDENTIALS.
# NEVER COMMIT REAL SECRETS OR SERVICE ROLE KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & HOSTING
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (SUPABASE POSTGRESQL / FREE-TIER PG)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for Drizzle ORM
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 3. SUPABASE AUTH & STORAGE (SERVER-SIDE SECRETS)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Server-only service role key — NEVER EXPOSE TO CLIENT/VITE
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
# Session & Cookie encryption secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your-32-byte-secure-random-session-secret

# ------------------------------------------------------------------------------
# 4. DIRECT UPI & RESTAURANT PAYMENT SETTINGS (DEFAULT ZERO-COST)
# ------------------------------------------------------------------------------
# The restaurant's bank-registered Virtual Payment Address (VPA)
DEFAULT_UPI_ID=radheradhe@sbi
DEFAULT_UPI_NAME=Shri Radhe Radhe Restaurant

# ------------------------------------------------------------------------------
# 5. FUTURE PAYMENT GATEWAYS (OPTIONAL / SWITCHABLE VIA ADMIN SETTINGS)
# ------------------------------------------------------------------------------
# Set when switching from Direct UPI to automated Razorpay gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL NOTIFICATIONS (FREE TIER: RESEND)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
RESTAURANT_NOTIFICATION_EMAIL=orders@radheradhe.com

# ------------------------------------------------------------------------------
# 7. CLIENT PUBLIC ENVIRONMENT VARIABLES (INJECTED INTO VITE BUNDLE)
# ------------------------------------------------------------------------------
# Must begin with VITE_ prefix to be exposed to the browser
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_MAP_ATTRIBUTION=© OpenMapTiles © OpenStreetMap contributors
VITE_TURNSTILE_SITE_KEY=
